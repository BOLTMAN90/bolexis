# BOLEXIS environment
# Copy to .env.local. Do not put real secrets in this file.
# On Vercel, set the same names. Use BOLEXIS_DATA_MODE=supabase and
# NEXT_PUBLIC_APP_URL=https://bolexis.vercel.app.
# In Supabase Auth, allow these redirect URLs:
# http://localhost:3000/auth/callback
# https://bolexis.vercel.app/auth/callback

# demo | supabase
# Local development uses demo when Supabase is unset.
BOLEXIS_DATA_MODE=demo
# Required only if you intentionally run demo data in production.
BOLEXIS_ALLOW_DEMO_IN_PRODUCTION=
DEMO_SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# n8n
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
INTEGRATION_ENCRYPTION_KEY=

# Protects POST /api/jobs/process
CRON_SECRET=
